<%- include('../partials/header') %>

<div class="page-actions">
  <div>
    <h1>ملاحظات وتوصيات الأولياء</h1>
    <div class="sub">ملاحظات وصلت من الإدارية عن أطفال فصلك</div>
  </div>
  <div id="noteAlerts" class="note-alerts-bar">
    <button type="button" id="noteSoundToggle" class="btn btn-secondary btn-sm"><i class="fa-solid fa-volume-xmark"></i> فعّلي التنبيه الصوتي</button>
  </div>
</div>

<div id="noteAlertBanner" class="note-alert-banner">
  <div class="na-icon"><i class="fa-solid fa-bell"></i></div>
  <div>
    <div class="na-title">ملاحظات تقترب وقت تنفيذها</div>
    <div id="noteAlertList"></div>
  </div>
</div>

<script type="application/json" id="noteAlertsData">
<%- JSON.stringify(notes.filter(n => n.status === 'pending' && n.note_time).map(n => ({
  id: n.id, note_type: n.note_type, note_date: n.note_date, note_time: n.note_time,
  child_name: n.child_name, content: n.content
}))) %>
</script>

<% if (!hasClass) { %>
  <div class="card">
    <div class="empty-state">
      <div class="es-icon">🏫</div>
      <h3>لم يتم تعيين فصل لحسابك بعد</h3>
      <p>يرجى التواصل مع إدارة الروضة لربط حسابك بأحد الفصول.</p>
    </div>
  </div>
<% } else if (!notes.length) { %>
  <div class="card mt-0">
    <div class="empty-state">
      <div class="es-icon">📝</div>
      <h3>لا توجد ملاحظات نشطة حاليًا</h3>
    </div>
  </div>
<% } else { %>

  <% notes.forEach(function(n) { %>
    <div class="card">
      <div class="flex-between" style="margin-bottom:10px; align-items:flex-start;">
        <div>
          <div style="font-weight:800; font-size:15px;"><%= n.child_name %></div>
          <div class="text-muted" style="font-size:12px; margin-top:2px;">
            <%= categoryLabels[n.category] %> · <%= n.note_type === 'daily' ? 'ملاحظة اليوم' : 'ملاحظة دائمة' %>
            <% if (n.note_time) { %> · <i class="fa-solid fa-bell"></i> <%= n.note_time %><% } %>
          </div>
        </div>
        <span class="badge <%= n.status === 'done' ? 'badge-executed' : 'badge-urgent' %>">
          <span class="badge-dot"></span> <%= n.status === 'done' ? 'تم الاطلاع' : 'بانتظار الاطلاع' %>
        </span>
      </div>

      <p style="margin-bottom:14px;"><%= n.content %></p>

      <% if (n.status === 'pending') { %>
        <form method="POST" action="/teacher/notes/<%= n.id %>/acknowledge">
          <div class="form-group mt-0">
            <label class="field-label">ملاحظة عند التأكيد (اختياري)</label>
            <input type="text" name="done_note" placeholder="مثال: تم إعطاء الدواء الساعة 12:15" />
          </div>
          <button type="submit" class="btn btn-success"><i class="fa-solid fa-check"></i> تأكيد الاطلاع/التنفيذ</button>
        </form>
      <% } else { %>
        <div class="alert alert-success" style="margin-bottom:0;">
          تم التأكيد<% if (n.done_note) { %>: <%= n.done_note %><% } %>
        </div>
      <% } %>
    </div>
  <% }) %>

<% } %>

<script src="/js/note-alerts.js"></script>
<%- include('../partials/footer') %>
